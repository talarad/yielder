{
  "name": "yielder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal savings & pension fund tracker: yields, peer comparison, Excel import",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env API_PORT=4000 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "test": "node --import tsx --test \"server/**/*.test.ts\"",
    "seed:demo": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/scripts/seed-demo.ts",
    "benchmarks:load": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/scripts/load-benchmarks.ts",
    "benchmarks:sync": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/scripts/sync-benchmarks.ts"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
