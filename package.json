{
  "name": "yielder",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Personal savings & pension fund tracker: returns net of deposits, market comparison, Excel import. Runs in the browser; data in your own Google Drive.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "benchmarks:sync": "tsx scripts/sync-benchmarks.ts"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sql.js": "^1.15.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
